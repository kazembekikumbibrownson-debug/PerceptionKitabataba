@model PerceptionKitabataba.Models.Eleve
@using PerceptionKitabataba.Models
@{
    ViewData["Title"] = "Fiche élève";
    var paiements = ViewBag.Paiements as List<PerceptionKitabataba.Models.Paiement> ?? new List<PerceptionKitabataba.Models.Paiement>();
}

<div class="d-flex justify-content-between align-items-center mb-3 d-print-none">
    <h2>👁️ Fiche de l'élève</h2>
    <div>
        <button onclick="window.print()" class="btn btn-primary">🖨️ Imprimer la fiche</button>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">✏️ Modifier</a>
        <a asp-action="Index" class="btn btn-outline-secondary">← Retour</a>
    </div>
</div>

<!-- FICHE IMPRIMABLE -->
<div class="card border-dark mb-4">
    <div class="card-header bg-dark text-white text-center py-3">
        <h3 class="mb-0">@ViewBag.NomEcole</h3>
        <div class="small">Année scolaire @ViewBag.AnneeScolaire — Fiche de situation financière</div>
    </div>
    <div class="card-body">
        <!-- Infos Élève -->
        <div class="row mb-4">
            <div class="col-md-6">
                <p class="mb-1"><strong>Nom complet :</strong> @Model.NomComplet</p>
                <p class="mb-1"><strong>Matricule :</strong> <code>@Model.Matricule</code></p>
                <p class="mb-1"><strong>Classe :</strong> @Model.NiveauComplet</p>
                <p class="mb-1"><strong>Sexe :</strong> @(Model.Sexe == "M" ? "Masculin" : "Féminin")</p>
            </div>
            <div class="col-md-6">
                <p class="mb-1"><strong>Tuteur :</strong> @Model.Tuteur</p>
                <p class="mb-1"><strong>Téléphone :</strong> @Model.Telephone</p>
                <p class="mb-1"><strong>Inscrit le :</strong> @Model.DateInscription.ToString("dd/MM/yyyy")</p>
                <p class="mb-1"><strong>Minerval à partir de :</strong> @Model.MoisDebutMinerval / @Model.AnneeDebutMinerval</p>
            </div>
        </div>

        <hr />

        <!-- Totaux Payés -->
        <div class="row text-center mb-4">
            <div class="col-6 border-end">
                <div class="text-muted small">Total payé (CDF)</div>
                <div class="h3 text-success fw-bold">@ViewBag.TotalPayeCDF.ToString("N0")</div>
            </div>
            <div class="col-6">
                <div class="text-muted small">Total payé (USD)</div>
                <div class="h3 text-success fw-bold">@ViewBag.TotalPayeUSD.ToString("N0")</div>
            </div>
        </div>

        <!-- Historique des paiements -->
        <h5 class="mt-4 border-bottom pb-2">Historique des paiements</h5>
        @if (!paiements.Any())
        {
            <p class="text-muted fst-italic">Aucun paiement enregistré pour cet élève.</p>
        }
        else
        {
            <table class="table table-sm table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>N° Reçu</th>
                        <th>Désignation</th>
                        <th class="text-end">Montant</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in paiements)
                    {
                        <tr>
                            <td>@p.DatePaiement.ToString("dd/MM/yyyy")</td>
                            <td>N° @p.NumeroRecu</td>
                            <td>@p.Frais?.Libelle</td>
                            <td class="text-end fw-bold">@p.Montant.ToString("N0") @p.Devise</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        
        <div class="mt-5 text-end">
            <p>Fait à Kitabataba, le @DateTime.Today.ToString("dd/MM/yyyy")</p>
            <p class="mt-4">Signature du percepteur</p>
        </div>
    </div>
</div>

<style>
    @@media print {
        .d-print-none { display: none !important; }
        body { background: white; }
        .card { border: none !important; box-shadow: none !important; }
        .card-header { background: #0b5c3f !important; color: white !important; -webkit-print-color-adjust: exact; }
    }
</style>