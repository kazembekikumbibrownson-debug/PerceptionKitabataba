@model IEnumerable<PerceptionKitabataba.Models.Paiement>
@{
    ViewData["Title"] = "Historique";
    var eleve = ViewBag.Eleve as PerceptionKitabataba.Models.Eleve;
}

<h2>📜 Historique — @eleve?.NomComplet</h2>
<a asp-action="Encaisser" asp-route-id="@eleve?.Id" class="btn btn-success mb-3">← Retour à la situation</a>

<table class="table table-sm">
    <thead class="table-success">
        <tr><th>Date</th><th>Reçu</th><th>Frais</th><th class="text-end">Montant</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.DatePaiement.ToString("dd/MM/yyyy")</td>
                <td>N° @p.NumeroRecu</td>
                <td>@p.Frais?.Libelle</td>
                <td class="text-end">@p.Montant.ToString("N0") @p.Devise</td>
                <td><a asp-action="RecuGroupe" asp-route-numero="@p.NumeroRecu" target="_blank" class="btn btn-sm btn-outline-primary">🖨️</a></td>
            </tr>
        }
    </tbody>
</table>