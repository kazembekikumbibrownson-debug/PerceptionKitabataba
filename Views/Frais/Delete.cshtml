@model PerceptionKitabataba.Models.Frais
@{
    ViewData["Title"] = "Supprimer un frais";
}

<h2 class="text-danger">🗑️ Supprimer un frais</h2>

<div class="alert alert-warning">
    <strong>Attention :</strong> cette action est irréversible.
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Libellé</dt>
            <dd class="col-sm-9"><strong>@Model.Libelle</strong></dd>

            <dt class="col-sm-3">Montant</dt>
            <dd class="col-sm-9">@Model.Montant.ToString("N0") @Model.Devise</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Confirmer la suppression</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
</form>