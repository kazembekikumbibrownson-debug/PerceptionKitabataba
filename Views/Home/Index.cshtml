@model PerceptionKitabataba.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Accueil";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold" style="color: #0b5c3f;">📊 Tableau de bord</h2>
    <div>
        <a asp-controller="Paiements" asp-action="Index" class="btn btn-success fw-bold">💵 Encaisser un paiement</a>
    </div>
</div>

<!-- SECTION : Aujourd'hui -->
<h5 class="text-muted mb-3">Aujourd'hui (@DateTime.Today.ToString("dd/MM/yyyy"))</h5>
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card bg-success text-white shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-white-50">Recettes du jour (CDF)</div>
                        <div class="h3 mb-0 fw-bold">@Model.RecettesJourCDF.ToString("N0")</div>
                    </div>
                    <div class="fs-1 opacity-50">💰</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-primary text-white shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-white-50">Recettes du jour (USD)</div>
                        <div class="h3 mb-0 fw-bold">@Model.RecettesJourUSD.ToString("N0")</div>
                    </div>
                    <div class="fs-1 opacity-50">💵</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-info text-white shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-white-50">Paiements enregistrés</div>
                        <div class="h3 mb-0 fw-bold">@Model.PaiementsJour</div>
                    </div>
                    <div class="fs-1 opacity-50">🧾</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ======================================================= -->
<!-- ⬇️⬇️⬇️ BLOC À INSÉRER ICI (SOLDE DE CAISSE) ⬇️⬇️⬇️ -->
<!-- ======================================================= -->
<div class="row mb-4">
    <div class="col-md-12">
        <div class="card shadow-sm border-0 bg-dark text-white">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="small text-white-50">Solde de caisse de la journée (Recettes CDF - Dépenses CDF)</div>
                    <div class="h2 mb-0 fw-bold">
                        @((Model.RecettesJourCDF - Model.DepensesJourCDF).ToString("N0")) CDF
                    </div>
                    @if (Model.DepensesJourCDF > 0)
                    {
                        <div class="small text-danger mt-1">(Moins @Model.DepensesJourCDF.ToString("N0") CDF de dépenses)</div>
                    }
                </div>
                <div class="fs-1 opacity-50">⚖️</div>
            </div>
        </div>
    </div>
</div>
<!-- ======================================================= -->
<!-- ⬆️⬆️⬆️ FIN DU BLOC À INSÉRER ⬆️⬆️⬆️ -->
<!-- ======================================================= -->
<!-- SECTION : Total global -->
<h5 class="text-muted mb-3 mt-5">Bilan global (Toutes les données)</h5>
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="small text-muted">Total des recettes (CDF)</div>
                <div class="h4 mb-0 fw-bold" style="color: #0b5c3f;">@Model.RecettesTotalesCDF.ToString("N0") CDF</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="small text-muted">Total des recettes (USD)</div>
                <div class="h4 mb-0 fw-bold" style="color: #0b5c3f;">@Model.RecettesTotalesUSD.ToString("N0") USD</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="small text-muted">Nombre d'élèves inscrits</div>
                    <div class="h4 mb-0 fw-bold text-dark">@Model.NombreEleves</div>
                </div>
                <a asp-controller="Eleves" asp-action="Index" class="btn btn-sm btn-outline-success">Voir la liste</a>
            </div>
        </div>
    </div>
</div>

<!-- SECTION : Derniers paiements -->
<div class="card shadow-sm border-0 mt-5">
    <div class="card-header bg-white border-bottom-0 pt-3 pb-0">
        <h5 class="fw-bold">🕒 Derniers reçus émis</h5>
    </div>
    <div class="card-body">
        @if (!Model.DerniersPaiements.Any())
        {
            <p class="text-muted mb-0">Aucun paiement n'a encore été enregistré dans l'application.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Reçu</th>
                            <th>Élève</th>
                            <th>Classe</th>
                            <th>Frais</th>
                            <th class="text-end">Montant</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.DerniersPaiements)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">N° @p.NumeroRecu</span></td>
                                <td>@p.Eleve?.NomComplet</td>
                                <td>@p.Eleve?.Niveau.Libelle()</td>
                                <td>@p.Frais?.Libelle</td>
                                <td class="text-end fw-bold">@p.Montant.ToString("N0") @p.Devise</td>
                                <td class="text-end">
                                    <a asp-controller="Paiements" asp-action="RecuGroupe" asp-route-numero="@p.NumeroRecu" target="_blank" class="btn btn-sm btn-outline-primary">
                                        🖨️ Reçu
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>